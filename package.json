{
  "name": "template-lightning",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev:client": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "bun app/index.ts",
    "dev:server": "bun --watch app/index.ts",
    "dev": "concurrently \"bun run dev:client\" \"bun run dev:server\"",
    "scripts:destroy-db": "bun run ./scripts/reset-db.ts"
  },
  "dependencies": {
    "@mantine/core": "^7.15.2",
    "@mantine/dates": "^7.15.2",
    "@mantine/form": "^7.15.2",
    "@mantine/hooks": "^7.15.2",
    "@mantine/notifications": "^7.15.2",
    "@mantine/tiptap": "^7.15.2",
    "@phosphor-icons/react": "^2.1.7",
    "@tiptap/extension-highlight": "^2.11.0",
    "@tiptap/extension-link": "^2.11.0",
    "@tiptap/extension-subscript": "^2.11.0",
    "@tiptap/extension-superscript": "^2.11.0",
    "@tiptap/extension-text-align": "^2.11.0",
    "@tiptap/extension-underline": "^2.11.0",
    "@tiptap/pm": "^2.11.0",
    "@tiptap/react": "^2.11.0",
    "@tiptap/starter-kit": "^2.11.0",
    "@types/express": "^5.0.0",
    "axios": "^1.7.9",
    "chalk": "^5.4.1",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.1.1",
    "sass": "^1.83.0"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
